    {
      "Name": "MessagesViewIndex",
      "Maps": [
        "docs.ProcessedMessages.Select(message => new {\n    MessageId = ((string) message.MessageMetadata[\"MessageId\"]),\n    MessageType = ((string) message.MessageMetadata[\"MessageType\"]),\n    IsSystemMessage = ((bool) message.MessageMetadata[\"IsSystemMessage\"]),\n    Status = ((bool) message.MessageMetadata[\"IsRetried\"]) ? 4 : 3,\n    TimeSent = ((DateTime) message.MessageMetadata[\"TimeSent\"]),\n    ProcessedAt = message.ProcessedAt,\n    ReceivingEndpointName = ((message.MessageMetadata[\"ReceivingEndpoint\"])).Name,\n    SendingEndpointName = ((message.MessageMetadata[\"SendingEndpoint\"])).Name,\n    CriticalTime = ((TimeSpan ? ) message.MessageMetadata[\"CriticalTime\"]),\n    ProcessingTime = ((TimeSpan ? ) message.MessageMetadata[\"ProcessingTime\"]),\n    DeliveryTime = ((TimeSpan ? ) message.MessageMetadata[\"DeliveryTime\"]),\n    Query = Enumerable.ToArray(DynamicEnumerable.Union(message.MessageMetadata.ToDictionary(e1 => e1.Key, e1 => e1.Value).Select(_ => _.Value.ToString()), new string[] {\n        String.Join(\" \", message.Headers.ToDictionary(e1 => e1.Key, e1 => e1.Value).Select(x => x.Value))\n    })),\n    ConversationId = ((string) message.MessageMetadata[\"ConversationId\"])\n})"
      ],
      "Fields": {
        "Query": {
          "Indexing": "Search",
          "Analyzer": "Lucene.Net.Analysis.Standard.StandardAnalyzer, Lucene.Net, Version=3.0.3.0, Culture=neutral, PublicKeyToken=85089178b9ac3181"
        }
      },
      "AdditionalSources": {},
      "AdditionalAssemblies": []
    },
    {
      "Name": "MessagesViewIndexWithFullTextSearch",
      "Maps": [
        "docs.ProcessedMessages.Select(message => new {\n    MessageId = ((string) message.MessageMetadata[\"MessageId\"]),\n    MessageType = ((string) message.MessageMetadata[\"MessageType\"]),\n    IsSystemMessage = ((bool) message.MessageMetadata[\"IsSystemMessage\"]),\n    Status = ((bool) message.MessageMetadata[\"IsRetried\"]) ? 4 : 3,\n    TimeSent = ((DateTime) message.MessageMetadata[\"TimeSent\"]),\n    ProcessedAt = message.ProcessedAt,\n    ReceivingEndpointName = ((message.MessageMetadata[\"ReceivingEndpoint\"])).Name,\n    SendingEndpointName = ((message.MessageMetadata[\"SendingEndpoint\"])).Name,\n    CriticalTime = ((TimeSpan ? ) message.MessageMetadata[\"CriticalTime\"]),\n    ProcessingTime = ((TimeSpan ? ) message.MessageMetadata[\"ProcessingTime\"]),\n    DeliveryTime = ((TimeSpan ? ) message.MessageMetadata[\"DeliveryTime\"]),\n    Query = Enumerable.ToArray(DynamicEnumerable.Union(message.MessageMetadata.ToDictionary(e1 => e1.Key, e1 => e1.Value).Select(_ => _.Value.ToString()), new string[] {\n        String.Join(\" \", message.Headers.ToDictionary(e1 => e1.Key, e1 => e1.Value).Select(x => x.Value)),\n        this.LoadAttachment(message, \"body\").GetContentAsString()\n    })),\n    ConversationId = ((string) message.MessageMetadata[\"ConversationId\"])\n})"
      ],
      "Fields": {
        "Query": {
          "Indexing": "Search",
          "Analyzer": "Lucene.Net.Analysis.Standard.StandardAnalyzer, Lucene.Net, Version=3.0.3.0, Culture=neutral, PublicKeyToken=85089178b9ac3181"
