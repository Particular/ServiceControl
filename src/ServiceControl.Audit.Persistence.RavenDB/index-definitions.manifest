    {
      "Name": "SagaDetailsIndex",
      "Maps": [
        "docs.SagaHistories.Select(doc => new {\n    SagaId = doc.SagaId,\n    Id = doc.SagaId,\n    SagaType = doc.SagaType,\n    Changes = doc.Changes\n})",
        "docs.SagaSnapshots.Select(doc => new {\n    SagaId = doc.SagaId,\n    Id = doc.SagaId,\n    SagaType = doc.SagaType,\n    Changes = new[] {\n        new {\n            Endpoint = doc.Endpoint,\n            FinishTime = doc.FinishTime,\n            InitiatingMessage = doc.InitiatingMessage,\n            OutgoingMessages = doc.OutgoingMessages,\n            StartTime = doc.StartTime,\n            StateAfterChange = doc.StateAfterChange,\n            Status = doc.Status\n        }\n    }\n})"
      ],
      "Reduce": "results.GroupBy(result => result.SagaId).Select(g => new {\n    g = g,\n    first = DynamicEnumerable.FirstOrDefault(g)\n}).Select(this0 => new {\n    Id = this0.first.SagaId,\n    SagaId = this0.first.SagaId,\n    SagaType = this0.first.SagaType,\n    Changes = Enumerable.ToList(DynamicEnumerable.OrderByDescending(this0.g.SelectMany(x => x.Changes), x0 => x0.FinishTime).Take(50000))\n})",
      "Fields": {
        "Changes": {
          "Indexing": "No"
        },
        "SagaId": {
          "Indexing": "Exact"
        },
        "SagaType": {
          "Indexing": "No"
        }
