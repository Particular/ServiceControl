<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TestCategory>Raven</TestCategory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ServiceControl.Audit.Persistence.InMemory\ServiceControl.Audit.Persistence.InMemory.csproj" />
    <!-- Needed to bring the dependencies that the persistence plugin excludes -->
    <ProjectReference Include="..\ServiceControl.Audit.Persistence\ServiceControl.Audit.Persistence.csproj" />
    <ProjectReference Include="..\TestHelper\TestHelper.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GitHubActionsTestLogger" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NServiceBus.CustomChecks" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="Particular.Approvals" />
  </ItemGroup>

  <ItemGroup>
    <!-- The InternalCustomCheckClassification code does not exist in Audit, including it here allows an 
         approval test instead of a very expensive acceptance test. -->
    <Compile Include="..\ServiceControl.Persistence\InternalCustomCheckClassification.cs" />
    <Compile Include="..\ServiceControl.UnitTests\NUnitParallelRunnerSettings.cs" />
  </ItemGroup>
</Project>
