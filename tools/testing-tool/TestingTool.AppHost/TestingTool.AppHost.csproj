<Project Sdk="Aspire.AppHost.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <AspireUseCliBundle>true</AspireUseCliBundle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.6.1" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.6.1" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" Version="13.6.1" />
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="13.6.1" />
    <PackageReference Include="Particular.Aspire.Hosting.ServicePlatform" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TestingTool\TestingTool.csproj" />
  </ItemGroup>

  <ItemGroup Label="Direct references to transitive dependencies to avoid versions with CVE">
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>