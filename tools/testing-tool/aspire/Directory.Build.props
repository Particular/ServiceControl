<Project>

  <!--
    Override the parent testing-tool Directory.Build.props for the file-based Aspire AppHost.
    The Aspire AppHost SDK manages its own build properties; we only need basic settings
    compatible with the SDK without inheriting warnings-as-errors or analyzer enforcement
    that could conflict with generated Aspire code.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>